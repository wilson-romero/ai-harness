# Copy to .env and adjust. Never put passwords, tokens or connection strings here.

# Where SQLite, logs and browser profiles live (ignored by Git).
HARNESS_DATA_DIR=./data

# mock | copilot_web
HARNESS_PROVIDER=mock

# Absolute path of the Markdown memory vault and the size limit, in UTF-8 bytes,
# of the project context sent with `ask --project` (1024-65536, default 8192). The harness only
# reads the vault, with one exception: `architecture-memory` writes one new note in Decisiones/
# after a human approval in a terminal (see "Skills de arquitectura" in the README).
HARNESS_VAULT_ROOT=
HARNESS_MEMORY_CONTEXT_MAX_BYTES=8192

# Absolute path of the skills root (default: skills/ of the repository) and the lifetime of a
# human approval in seconds (60-3600, default 900).
HARNESS_SKILLS_DIR=
HARNESS_APPROVAL_TTL_S=900

# on | off (default off): with on, a fixed notice asking for short answers goes first in
# every plain question (`ask`, `chat`), never in a Skill step. Off by default until its
# effect is measured with real Copilot: it costs 55 tokens per question.
HARNESS_CONCISE_ANSWERS=off

# Tests and demos only: absolute path of a JSON object of text -> scripted Mock answer.
HARNESS_MOCK_RESPONSES=

# Dedicated Edge profile directory (not the personal or everyday work profile).
HARNESS_EDGE_PROFILE=
HARNESS_COPILOT_URL=
# Seconds to wait for the Copilot page to be ready (default 60).
HARNESS_COPILOT_READY_TIMEOUT_S=
# Optional: lower the prompt size limit measured by the probe. It can never raise it.
HARNESS_COPILOT_MAX_PROMPT_CHARS=

# Absolute path of the local allowlist of MCP servers (JSON, edited by hand). It must live
# outside the repository or in a Git-ignored path; without it there are no servers.
# On macOS and Linux it must not be writable by the group, by others or by another user
# (chmod 600); on Windows the ACL is not checked.
HARNESS_MCP_CONFIG=

# Local identifiers of allowlisted Enterprise Architect targets (not connection strings).
EA_READ_TARGET_ID=
EA_TEST_TARGET_ID=
