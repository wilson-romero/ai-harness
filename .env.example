# Copy to .env and adjust. Never put passwords, tokens or connection strings here.

# Where SQLite, logs and browser profiles live (ignored by Git).
HARNESS_DATA_DIR=./data

# mock | copilot_web
HARNESS_PROVIDER=mock

# Absolute path of the Markdown memory vault (read-only) and the size limit, in UTF-8 bytes,
# of the project context sent with `ask --project` (1024-65536, default 8192).
HARNESS_VAULT_ROOT=
HARNESS_MEMORY_CONTEXT_MAX_BYTES=8192

# Dedicated Edge profile directory (not the personal or everyday work profile).
HARNESS_EDGE_PROFILE=
HARNESS_COPILOT_URL=
# Seconds to wait for the Copilot page to be ready (default 60).
HARNESS_COPILOT_READY_TIMEOUT_S=
# Optional: lower the prompt size limit measured by the probe. It can never raise it.
HARNESS_COPILOT_MAX_PROMPT_CHARS=

# Local allowlist of MCP servers.
HARNESS_MCP_CONFIG=

# Local identifiers of allowlisted Enterprise Architect targets (not connection strings).
EA_READ_TARGET_ID=
EA_TEST_TARGET_ID=
